<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <RelativeLayout
        android:id="@+id/editNoteRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation= "vertical"
        tools:context = ".updateNoteFragment"
        android:padding="12dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/editNoteHeading"
            android:layout_alignParentTop="true"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins"
            android:text="Edit Note."
            android:textStyle="bold"
            android:textColor="@color/orangeRed"
            android:textSize="24sp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:id="@+id/editNoteTitle"
            android:hint="Enter the title"
            android:padding="12dp"
            android:textSize="20sp"
            android:layout_below="@id/editNoteHeading"
            android:background="@drawable/border"
            android:layout_marginTop="16dp"
            android:maxLines="1"
            android:fontFamily="@font/poppins"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/editNoteDesc"
            android:hint="Enter the description"
            android:gravity="top"
            android:padding="12dp"
            android:textSize="18dp"
            android:fontFamily="@font/poppins"
            android:background="@drawable/border"
            android:layout_below="@id/editNoteTitle"
            android:layout_marginTop="12dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/recordFab"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="100dp"
            android:clickable="true"
            android:backgroundTint="@color/orangeRed"
            android:tintMode="@color/white"
            android:src="@android:drawable/ic_btn_speak_now"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:contentDescription="recordFab"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/scanFab"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="180dp"
            android:clickable="true"
            android:backgroundTint="@color/orangeRed"
            android:tintMode="@color/white"
            android:src="@android:drawable/ic_menu_camera"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:contentDescription="scanFab"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/editNoteFab"
            android:layout_marginEnd="20dp"
            android:clickable="true"
            android:backgroundTint="@color/lightSalmon"
            android:tintMode="@color/white"
            android:src="@drawable/outline_done_outline_24"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:contentDescription="editFab"/>



    </RelativeLayout>




</layout>